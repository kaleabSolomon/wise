---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Viewer from "../components/Viewer.astro";
---

<Base>
  <div class="ground">
    <Hero />
    <div class="wrap"><Viewer /></div>
  </div>
</Base>

<style>
  .ground {
    min-height: 100vh;
    background: var(--ground);
  }
</style>
